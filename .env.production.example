# Public DNS hostname, without https:// or a path.
CENTER_DOMAIN=

# Use a different random value for each entry, for example openssl rand -hex 32.
CENTER_INTERNAL_KEY=
CENTER_DB_ADMIN_PASSWORD=
CENTER_IDENTITY_DB_PASSWORD=
CENTER_PEOPLE_DB_PASSWORD=
CENTER_EDUCATION_DB_PASSWORD=
CENTER_WORK_DB_PASSWORD=
CENTER_DOCUMENTS_DB_PASSWORD=

# Initial platform administrator. First sign-in requires a password change.
CENTER_PLATFORM_EMAIL=
CENTER_PLATFORM_PASSWORD=

# Persistent folder with licensed Tufuli Arabic web fonts.
# CENTER_FONTS_DIR=/opt/quran-center/production/fonts

# Password recovery via SMTP with STARTTLS.
CENTER_SMTP_HOST=
CENTER_SMTP_PORT=587
CENTER_SMTP_FROM=
CENTER_SMTP_USER=
CENTER_SMTP_PASSWORD=
