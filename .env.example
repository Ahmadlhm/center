# Copy to .env and replace the development values before a shared deployment.
CENTER_ORIGIN=http://localhost:8088
CENTER_ALLOW_HTTP=true
CENTER_DEMO=true
CENTER_PORT=8088
CENTER_BIND=127.0.0.1
CENTER_INTERNAL_KEY=local-compose-internal-key-replace-before-deployment
CENTER_DB_ADMIN_PASSWORD=local-db-admin-replace
CENTER_IDENTITY_DB_PASSWORD=local-identity-replace
CENTER_PEOPLE_DB_PASSWORD=local-people-replace
CENTER_EDUCATION_DB_PASSWORD=local-education-replace
CENTER_WORK_DB_PASSWORD=local-work-replace
CENTER_DOCUMENTS_DB_PASSWORD=local-documents-replace
CENTER_PLATFORM_EMAIL=
CENTER_PLATFORM_PASSWORD=
# Password recovery email (optional; enable STARTTLS on the configured SMTP server)
CENTER_SMTP_HOST=
CENTER_SMTP_PORT=587
CENTER_SMTP_FROM=
CENTER_SMTP_USER=
CENTER_SMTP_PASSWORD=
